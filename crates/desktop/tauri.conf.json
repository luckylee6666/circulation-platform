{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "流转平台",
  "version": "0.1.0",
  "identifier": "com.byteflux.circulation",
  "build": {
    "frontendDist": "../../apps/web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "console",
        "url": "console.html",
        "title": "流转平台 · 服务控制台",
        "width": 960,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
